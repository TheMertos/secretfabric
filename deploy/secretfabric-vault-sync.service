[Unit]
Description=SecretFabric to Hermes Vault sync worker
After=network-online.target secretfabric.service
Wants=secretfabric.service

[Service]
Type=simple
User=mert
WorkingDirectory=/home/mert/secretfabric
EnvironmentFile=/etc/secretfabric/secretfabric.env
Environment=HERMES_HOME=/home/mert/.hermes
Environment=HERMES_AGENT_DIR=/home/mert/.hermes/hermes-agent/agent
ExecStart=/usr/bin/python3 /home/mert/secretfabric/tools/vault_sync_worker.py --interval 5
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
