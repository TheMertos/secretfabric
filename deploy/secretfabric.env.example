# Copy to /etc/secretfabric/secretfabric.env and restrict it with: chmod 600
# Do not commit the real file. The native service uses the SQLite URL below.

APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info
DATABASE_URL=file:/var/lib/secretfabric/secretfabric.sqlite
TAILSCALE_BASE_URL=https://secrets.example.ts.net
# 32-byte key, hex encoded. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
# Long random token. Generate with: openssl rand -hex 32
SECRET_FABRIC_API_TOKEN=
SECRET_FABRIC_URL=http://127.0.0.1:3000
SECRET_FABRIC_PUBLIC_URL=https://secrets.example.ts.net
HERMES_HOME=/home/mert/.hermes
