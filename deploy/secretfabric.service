[Unit]
Description=SecretFabric native Next.js service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mert
WorkingDirectory=/home/mert/secretfabric
EnvironmentFile=/etc/secretfabric/secretfabric.env
ExecStartPre=/usr/bin/node /home/mert/secretfabric/scripts/assert-native-startup.mjs
ExecStart=/usr/bin/yarn start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
