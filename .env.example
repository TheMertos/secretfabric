# SecretFabric runtime configuration.
# Production values live in /etc/secretfabric/secretfabric.env (mode 0600), not in this file.
# See deploy/secretfabric.env.example. Do not put real keys or tokens here.
APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=file:/var/lib/secretfabric/secretfabric.sqlite
TAILSCALE_BASE_URL=https://secrets.example.ts.net
SECRET_FABRIC_URL=http://127.0.0.1:3000
SECRET_FABRIC_PUBLIC_URL=https://secrets.example.ts.net
SECRET_FABRIC_API_TOKEN=
ENCRYPTION_KEY=
