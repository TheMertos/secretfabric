generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id          String           @id @default(uuid()) @db.Uuid
  slug        String           @unique
  displayName String
  createdAt   DateTime         @default(now())
  resources   Resource[]
  bots        BotIdentity[]
  memberships AccountMembership[]
}

model BotIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  accountId       String   @db.Uuid
  name            String
  externalSubject String   @unique
  status          String   @default("active")
  createdAt       DateTime @default(now())
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model AccountMembership {
  accountId String   @db.Uuid
  subject   String
  role      String
  createdAt DateTime @default(now())
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@id([accountId, subject])
}

model Resource {
  id              String            @id @default(uuid()) @db.Uuid
  accountId       String            @db.Uuid
  resourceType    String
  name            String
  metadata        Json?
  currentVersion  Int               @default(1)
  status          String            @default("active")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  versions        ResourceVersion[]
  shares          ResourceShare[]
  claims          Claim[]
  vaultSyncJobs   VaultSyncJob[]
  @@unique([accountId, name])
  @@index([accountId, resourceType])
}

model ResourceVersion {
  id              String   @id @default(uuid()) @db.Uuid
  resourceId      String   @db.Uuid
  version         Int
  encryptedPayload Bytes
  payloadNonce    Bytes
  createdBy       String
  createdAt       DateTime @default(now())
  resource        Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  @@unique([resourceId, version])
}

model ResourceShare {
  id               String       @id @default(uuid()) @db.Uuid
  resourceId       String       @db.Uuid
  sourceAccountId  String       @db.Uuid
  targetAccountId  String?      @db.Uuid
  targetBotId      String?      @db.Uuid
  role             String
  allowedOperations Json
  allowedPaths     Json?
  expiresAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  resource         Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  @@index([targetAccountId, targetBotId])
}

model Claim {
  id              String    @id @default(uuid()) @db.Uuid
  resourceId      String    @db.Uuid
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  revokedAt       DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  resource        Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
}

model VaultSyncJob {
  id          String    @id @default(uuid()) @db.Uuid
  resourceId  String    @db.Uuid
  version     Int
  vaultItemId String?
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resource    Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, version])
  @@index([status, createdAt])
}

model AuditEvent {
  id             BigInt   @id @default(autoincrement())
  timestamp      DateTime @default(now())
  actor          String
  consumer       String?
  resourceId     String?  @db.Uuid
  operation      String
  fieldPaths     Json?
  result         String
  failureCode    String?
  requestId      String   @db.Uuid
  @@index([resourceId, timestamp])
}
